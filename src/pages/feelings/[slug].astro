---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro'; import Nav from '../../components/Nav.astro'; import Footer from '../../components/Footer.astro'; import { feelings } from '../../data/feelings';
export function getStaticPaths(){return feelings.map(feeling=>({params:{slug:feeling.slug},props:{feeling}}));}
const {feeling}=Astro.props; const destinations = await getCollection('destinations'); const places=destinations.filter(d=>d.data.feelings.includes(feeling.slug)).map(d=>({slug:d.slug,...d.data})).sort((a,b)=>a.name.localeCompare(b.name)); const base=import.meta.env.BASE_URL; const image=`${base}${feeling.image.replace(/^\//,'')}`;
---
<BaseLayout title={`${feeling.title} Places | Chloe's Adventure Guide`} bodyClass="collection-page"><a class="collection-back" href={`${base}#feel`}>← All feelings</a><Nav /><header class="collection-hero" id="collectionHero" style={`--collection-image:url('${image}')`}><div class="collection-hero-shade"></div><div class="wrap collection-hero-copy"><div class="eyebrow">A curated travel collection</div><h1>{feeling.title}</h1><p>{feeling.intro}</p></div></header><main><section class="section collection-body"><div class="wrap"><div class="collection-intro"><div class="eyebrow rust">Why these places belong together</div><p>{feeling.note}</p></div><div class="collection-gallery">{places.map(place=>(<a class:list={['collection-place',!place.featuredImage&&'no-photo']} href={`${base}destinations/${place.slug}/?from=collection&feeling=${feeling.slug}`} style={place.featuredImage?`--place-image:url('${base}${place.featuredImage}')`:''}><div><span>{place.country}</span><h3>{place.name}</h3><p>{place.note}</p><em>Enter destination →</em></div></a>))}</div></div></section></main><Footer /></BaseLayout>
