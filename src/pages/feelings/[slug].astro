---
import RedirectPage from '../../components/RedirectPage.astro';
import { categories, legacyFeelingRedirects } from '../../data/categories';

// The site used to group destinations by feeling (/feelings/wild/, etc.).
// Keep those old URLs working by sending each one to its closest category.
export function getStaticPaths() {
  return Object.entries(legacyFeelingRedirects).map(([slug, categorySlug]) => ({
    params: { slug },
    props: { category: categories.find(c => c.slug === categorySlug)! },
  }));
}

const { category } = Astro.props;
---

<RedirectPage to={`explore/${category.slug}/`} label={category.title} />
