---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { categories } from '../../data/categories';

export function getStaticPaths() {
  return categories.map(category => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const destinations = await getCollection('destinations');
const places = destinations
  .filter(d => d.data.categories.includes(category.slug))
  .map(d => ({ slug: d.slug, ...d.data }))
  .sort((a, b) => a.name.localeCompare(b.name));
const base = import.meta.env.BASE_URL;
const image = `${base}${category.image.replace(/^\//, '')}`;
---

<BaseLayout title={`${category.title} | Chloe's Adventure Guide`} description={category.note}>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="hero-copy">
        <a class="back" href={`${base}#explore`}>← All categories</a>
        <p class="kicker">A curated collection</p>
        <h1>{category.title}</h1>
        <p class="intro">{category.intro}</p>
      </div>
      <figure class="hero-photo"><img src={image} alt={category.imageAlt ?? ''} fetchpriority="high" /></figure>
    </section>

    <section class="note">
      <p class="kicker">Why these places belong together</p>
      <p class="lead">{category.note}</p>
    </section>

    <section class="places">
      <p class="kicker">The places</p>
      <h2>{places.length} {places.length === 1 ? 'place' : 'places'} in this collection.</h2>
      <div class="rows">
        {places.map(place => (
          <a class="row" href={`${base}destinations/${place.slug}/?from=category&category=${category.slug}`}>
            <span>{place.country}</span><strong>{place.name}</strong><em>{place.note}</em><i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero { display:grid; grid-template-columns:1fr 1fr; gap:6vw; align-items:center; padding:48px var(--gutter) 100px; }
  .back { display:inline-block; margin-bottom:32px; font-size:.85rem; font-weight:600; color:var(--muted); }
  .back:hover { color:var(--rust); }
  h1 { margin:0 0 24px; font-size:clamp(3.6rem,8vw,7.2rem); line-height:.92; }
  .intro { max-width:36ch; margin:0; font-size:1.2rem; line-height:1.6; color:var(--body); }
  .hero-photo { margin:0; height:min(76vh,700px); border-radius:4px; overflow:hidden; }

  .note { padding:90px var(--gutter); text-align:center; background:var(--cream); }
  .lead { max-width:26ch; margin:0 auto; font-family:var(--serif); font-style:italic; font-weight:350; font-size:clamp(1.7rem,3vw,2.4rem); line-height:1.3; }

  .places { padding:100px var(--gutter); }
  h2 { margin:0 0 44px; font-size:clamp(2.4rem,4.5vw,4rem); line-height:1; }
  .rows { border-top:1px solid var(--line); }
  .row { display:grid; grid-template-columns:1fr 1.2fr 2.2fr auto; gap:24px; align-items:baseline; padding:22px 0; border-bottom:1px solid var(--line); transition:padding .25s ease, color .25s ease; }
  .row:hover, .row:focus-visible { padding-left:12px; color:var(--rust); }
  .row span { font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); }
  .row strong { font-family:var(--serif); font-weight:400; font-size:1.5rem; }
  .row em { font-style:normal; color:var(--muted); }
  .row i { font-style:normal; }

  @media (max-width:900px) {
    .hero { grid-template-columns:1fr; padding-bottom:70px; }
    .hero-photo { height:56vh; }
    .note, .places { padding:70px var(--gutter); }
    .row { grid-template-columns:1fr; gap:4px; }
    .row i { display:none; }
  }
  @media (prefers-reduced-motion:reduce) { .row { transition:none; } }
</style>
