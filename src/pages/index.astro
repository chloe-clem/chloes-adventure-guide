---
import BaseLayout from '../layouts/BaseLayout.astro'; import Nav from '../components/Nav.astro'; import EarthIntro from '../components/EarthIntro.astro'; import FeelingGrid from '../components/FeelingGrid.astro'; import AtlasList from '../components/AtlasList.astro'; import Footer from '../components/Footer.astro'; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Chloe's Travel Atlas" bodyClass="home home-v35"><Nav dark /><EarthIntro /><main class="atlas-flow"><FeelingGrid /><AtlasList /><section class="section about-dark" id="about"><div class="wrap about-grid"><div class="eyebrow">Why this exists</div><p class="fade">Travel should broaden your perspective, spark your curiosity, and embrace the way you love to explore.</p></div></section></main><Footer /><script is:inline src={`${base}scripts/home.js`}></script></BaseLayout>
