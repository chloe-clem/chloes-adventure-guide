---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FeelingGrid from '../components/FeelingGrid.astro';
import AtlasList from '../components/AtlasList.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Chloe's Adventure Guide">
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="kicker">A personal travel guide</p>
        <h1>Chloe’s<br />Adventure Guide</h1>
        <p class="tagline">Personal recommendations for trips that change how you see the world.</p>
        <a class="text-link" href="#feel">Start exploring →</a>
      </div>
      <figure class="hero-photo">
        <img src={`${base}photos/chloe/IMG_3652.webp`} alt="Chloe smiling, sitting in golden autumn light beside a meadow." width="1200" height="1800" fetchpriority="high" />
      </figure>
    </section>

    <section class="why" id="why">
      <p class="kicker">Why I travel</p>
      <p class="lead">Travel makes me feel alive. I travel to feel more connected to others and this beautiful world.</p>
      <div class="why-body">
        <figure class="why-photo">
          <img src={`${base}photos/chloe/IMG_3245.webp`} alt="Chloe looking back over her shoulder among autumn trees and fallen leaves." width="900" height="1125" loading="lazy" />
        </figure>
        <div class="why-text">
          <p class="story">There’s something about dropping yourself in a totally unfamiliar place that <em>grounds you in the present moment</em> like nothing else. You don’t realize how much of your life, including your thoughts and actions, happens subconsciously because it’s what you know. Traveling challenges this and opens up questions that help you <em>understand yourself better</em> and step into the driver’s seat of your life.</p>
          <p class="aside">After living in both the Netherlands and Sweden and spending many weekends adventuring around Europe, I have collected countless stories and recommendations I am excited to share!</p>
        </div>
      </div>
      <p class="invite">Use this page to explore my experiences and find the trip that will change your life. <a href="#feel" aria-label="Start with how you want to feel">↓</a></p>
    </section>

    <FeelingGrid />
    <AtlasList />

    <section class="mission">
      <p class="kicker">Why this exists</p>
      <p class="mission-line">Travel should broaden your perspective, spark your curiosity, and embrace the way you love to explore.</p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero { display:grid; grid-template-columns:1fr 1fr; gap:6vw; align-items:center; padding:48px var(--gutter) 110px; }
  .hero h1 { font-size:clamp(3.4rem,7vw,6.6rem); line-height:.95; margin:0 0 28px; }
  .tagline { font-size:1.25rem; line-height:1.55; max-width:30ch; color:var(--body); margin:0 0 34px; }
  .hero-photo { margin:0; height:min(80vh,760px); border-radius:4px; overflow:hidden; }
  .hero-photo img { object-position:50% 62%; }

  .why { padding:90px var(--gutter) 100px; border-top:1px solid var(--line); }
  .why > .kicker { text-align:center; }
  .lead { max-width:24ch; margin:0 auto; font-family:var(--serif); font-style:italic; font-weight:350; font-size:clamp(1.8rem,3.4vw,2.8rem); line-height:1.25; text-align:center; }
  .why-body { display:grid; grid-template-columns:.85fr 1.15fr; gap:5vw; align-items:center; max-width:1100px; margin:56px auto 0; padding-top:56px; border-top:1px solid var(--line); }
  .why-photo { margin:0; aspect-ratio:4/5; border-radius:4px; overflow:hidden; }
  .why-photo img { object-position:50% 50%; }
  .story { margin:0 0 32px; font-size:1.15rem; line-height:1.8; color:var(--body); }
  .story em { font-family:var(--serif); font-style:italic; font-size:1.1em; color:var(--rust); }
  .aside { margin:0; padding-left:22px; border-left:2px solid var(--rust); font-size:1rem; line-height:1.65; color:var(--muted); }
  .invite { max-width:40ch; margin:56px auto 0; text-align:center; font-family:var(--serif); font-size:1.3rem; line-height:1.45; }
  .invite a { display:inline-block; margin-left:4px; color:var(--rust); transition:transform .2s; }
  .invite a:hover { transform:translateY(3px); }

  .mission { padding:110px var(--gutter); background:var(--cream); text-align:center; }
  .mission-line { max-width:22ch; margin:0 auto; font-family:var(--serif); font-weight:350; font-size:clamp(1.9rem,3.6vw,3.2rem); line-height:1.2; letter-spacing:-.02em; }

  @media (max-width:900px) {
    .hero { grid-template-columns:1fr; padding-bottom:80px; }
    .hero-photo { height:70vh; }
    .why { padding:70px var(--gutter); }
    .why-body { grid-template-columns:1fr; gap:32px; margin-top:40px; padding-top:36px; }
    .why-photo { aspect-ratio:4/3; }
    .why-photo img { object-position:50% 20%; }
    .invite { margin-top:40px; font-size:1.15rem; }
    .mission { padding:80px var(--gutter); }
  }
</style>
