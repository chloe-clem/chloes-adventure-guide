---
interface Props {
  label: string;
  heading?: string;
  quote?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const { label, heading, quote, imageSrc, imageAlt = '' } = Astro.props;
---

<section class:list={['take', imageSrc && 'has-image']} id="take">
  <div class="take-inner fade">
    <div class="take-content">
      <p class="kicker">{label}</p>
      {heading && <h2>{heading}</h2>}
      {quote && <blockquote>“{quote}”</blockquote>}
      <div class="copy">
        <slot />
      </div>
    </div>
    {imageSrc && <figure><img src={imageSrc} alt={imageAlt} loading="lazy" /></figure>}
  </div>
</section>

<style>
  .take { padding:100px var(--gutter); border-top:1px solid var(--line); }
  .take-inner { max-width:760px; }
  .has-image .take-inner { max-width:none; display:grid; grid-template-columns:minmax(0,740px) minmax(280px,420px); gap:6vw; align-items:start; }
  h2 { max-width:14ch; margin:0 0 32px; font-size:clamp(2.6rem,5vw,4.4rem); line-height:1; }
  blockquote { margin:0 0 36px; padding:4px 0 4px 24px; border-left:2px solid var(--rust); font-family:var(--serif); font-style:italic; font-weight:350; font-size:clamp(1.4rem,2.4vw,1.8rem); line-height:1.35; }
  /* The story body is Markdown rendered through the slot, so it needs :global to be styled here. */
  .copy :global(p) { margin:0; color:var(--body); font-size:1.12rem; line-height:1.75; }
  .copy :global(p + p) { margin-top:24px; }
  .copy :global(p:first-child) { font-size:1.22rem; color:var(--ink); }
  figure { margin:0; aspect-ratio:3/4; border-radius:4px; overflow:hidden; position:sticky; top:calc(var(--header-h) + 32px); }
  @media (max-width:1000px) {
    .has-image .take-inner { grid-template-columns:1fr; }
    figure { position:static; aspect-ratio:4/3; max-width:740px; }
  }
  @media (max-width:600px) { .take { padding:70px var(--gutter); } }
</style>
