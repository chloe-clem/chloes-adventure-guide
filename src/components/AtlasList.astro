---
import { getCollection } from 'astro:content';
// getCollection() doesn't guarantee any particular order (it reflects filesystem
// read order, not insertion order), so sort explicitly for a stable, browsable list.
const destinations = (await getCollection('destinations')).sort((a, b) =>
  a.data.country.localeCompare(b.data.country) || a.data.name.localeCompare(b.data.name),
);
const continents = [...new Set(destinations.map(d=>d.data.continent))].sort();
const countries = [...new Set(destinations.map(d=>d.data.country))].sort();
const base=import.meta.env.BASE_URL;
---
<section class="destination-ribbon" id="atlas-list"><div class="wrap">
  <div class="ribbon-head"><div><div class="eyebrow rust">Explore by location</div><h2>The complete atlas</h2></div><p>Search every destination directly, or narrow the list by continent and country.</p></div>
  <div class="atlas-search-row"><label class="atlas-search">Search destinations<input id="destinationSearch" type="search" placeholder="Try Leiden, Switzerland, mountains…" /></label><div class="geography-filters"><label>Continent<select id="continentFilter"><option value="all">All continents</option>{continents.map(v=><option value={v}>{v}</option>)}</select></label><label>Country<select id="countryFilter"><option value="all">All countries</option>{countries.map(v=><option value={v}>{v}</option>)}</select></label><button id="clearGeo" type="button">Clear</button></div></div>
  <p class="result-count" id="resultCount"></p><div class="destination-list" id="destinationList">{destinations.map(d => (<a class="destination-line" href={`${base}destinations/${d.slug}/?from=atlas`} data-status="documented" data-search={`${d.data.name} ${d.data.country} ${d.data.continent} ${d.data.note} ${d.data.feelings.join(' ')}`} data-continent={d.data.continent} data-country={d.data.country}><span>{d.data.country}</span><strong>{d.data.name}</strong><em>{d.data.note}</em><i>Explore →</i></a>))}</div>
</div></section>
<script>
  const items=[...document.querySelectorAll<HTMLElement>('.destination-line')];
  const search=document.querySelector<HTMLInputElement>('#destinationSearch');
  const continent=document.querySelector<HTMLSelectElement>('#continentFilter');
  const country=document.querySelector<HTMLSelectElement>('#countryFilter');
  const count=document.querySelector<HTMLElement>('#resultCount');
  const render=()=>{
    const q=(search?.value||'').trim().toLowerCase();
    let visible=0;
    items.forEach(item=>{
      const ok=(!q||item.dataset.search?.toLowerCase().includes(q))
        &&(continent?.value==='all'||item.dataset.continent===continent?.value)
        &&(country?.value==='all'||item.dataset.country===country?.value);
      item.hidden=!ok;
      if(ok)visible++;
    });
    if(count)count.textContent=`${visible} ${visible===1?'place':'places'} in view`;
  };
  search?.addEventListener('input',render);
  continent?.addEventListener('change',render);
  country?.addEventListener('change',render);
  document.querySelector('#clearGeo')?.addEventListener('click',()=>{
    if(search)search.value='';
    if(continent)continent.value='all';
    if(country)country.value='all';
    render();
  });
  render();
</script>
