---
import type { Recommendation } from '../lib/recommendations';
import { getAvailableInterests, interestLabels } from '../lib/recommendations';

interface Props {
  destinationName: string;
  recommendations: Recommendation[];
}

const { destinationName, recommendations } = Astro.props;
const availableInterests = getAvailableInterests(recommendations);
---

<div class="shared-explorer shared-explorer-sticky">
  <div class="wrap shared-explorer-inner">
    <div class="shared-explorer-heading">
      <h2>Explore {destinationName} Your Way</h2>
      <p>Choose an interest to see recommendations and map locations.</p>
    </div>
    <div aria-label={`Filter ${destinationName} recommendations and map`} class="shared-filters">
      <button class="shared-filter active" data-filter="all">All</button>
      {availableInterests.map((interest) => (
        <button class="shared-filter" data-filter={interest}>{interestLabels[interest]}</button>
      ))}
    </div>
    <p aria-live="polite" class="filter-status" id="filterStatus">Showing every recommendation and map location.</p>
  </div>
</div>
