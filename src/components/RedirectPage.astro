---
interface Props {
  to: string;
  label: string;
}

const { to, label } = Astro.props;
const destination = `${import.meta.env.BASE_URL}${to}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Page moved | Chloe's Adventure Guide</title>
    <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
  </head>
  <body>
    <p>This page has moved to <a href={destination}>{label}</a>.</p>
  </body>
</html>
